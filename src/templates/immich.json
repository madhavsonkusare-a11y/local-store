  "promotion": {
    "state": "approved",
    "reason": "Owner-approved offering from a pinned Runtipi definition. Managed-engine proof of Immich 3.2.0 created the first administrator, uploaded an owned photo, found it by filename and downloaded identical bytes after install, restart and keep-data reinstall."
  },
  "data_storage": "Docker named volumes for database and model cache; a chosen host folder for photos and videos",
  "risk_notes": [
    "Creates 4 Docker containers and publishes one port on this computer's loopback interface only.",
    "Reads and writes a folder on this computer that you choose during setup. Nothing outside that folder is shared with it.",
    "Generates 2 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps database and model cache in managed Docker named volumes. A keep-data uninstall retains them; deleting data removes them.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Asks you to create the first account, which becomes the administrator.",
    "Photos, videos and thumbnails go in the folder you choose; the database stays in a managed named volume.",
    "Its machine-learning service downloads a model the first time it runs, so searching by face or content works only after that finishes.",
    "Immich changes quickly: read its release notes before moving to a newer version, because some releases migrate the database."
  ],
  "fields": {
    "FOLDER_IMAGES_IMMICH": {
      "label": "Folder to keep your photos and videos in",
      "sensitive": false
    }
  },
  "definition": "{\n  \"services\": [\n    {\n      \"name\": \"immich\",\n      \"image\": \"ghcr.io/immich-app/immich-server:v3.1.0\",\n      \"isMain\": true,\n      \"internalPort\": 2283,\n      \"environment\": [\n        {\n          \"key\": \"NODE_ENV\",\n          \"value\": \"production\"\n        },\n        {\n          \"key\": \"DB_HOSTNAME\",\n          \"value\": \"immich-db\"\n        },\n        {\n          \"key\": \"DB_USERNAME\",\n          \"value\": \"tipi\"\n        },\n        {\n          \"key\": \"DB_PASSWORD\",\n          \"value\": \"${DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"ENABLE_MAPBOX\",\n          \"value\": \"false\"\n        },\n        {\n          \"key\": \"DB_DATABASE_NAME\",\n          \"value\": \"immich\"\n        },\n        {\n          \"key\": \"REDIS_HOSTNAME\",\n          \"value\": \"immich-redis\"\n        },\n        {\n          \"key\": \"JWT_SECRET\",\n          \"value\": \"${JWT_SECRET}\"\n        }\n      ],\n      \"dependsOn\": [\"immich-redis\", \"immich-db\"],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${ROOT_FOLDER_HOST}/media/data/images/immich\",\n          \"containerPath\": \"/usr/src/app/upload\"\n        }\n      ]\n    },\n    {\n      \"name\": \"immich-machine-learning\",\n      \"image\": \"ghcr.io/immich-app/immich-machine-learning:v3.1.0\",\n      \"environment\": [\n        {\n          \"key\": \"NODE_ENV\",\n          \"value\": \"production\"\n        },\n        {\n          \"key\": \"DB_HOSTNAME\",\n          \"value\": \"immich-db\"\n        },\n        {\n          \"key\": \"DB_USERNAME\",\n          \"value\": \"tipi\"\n        },\n        {\n          \"key\": \"DB_PASSWORD\",\n          \"value\": \"${DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"DB_NAME\",\n          \"value\": \"immich\"\n        },\n        {\n          \"key\": \"DB_DATABASE_NAME\",\n          \"value\": \"immich\"\n        }\n      ],\n      \"dependsOn\": [\"immich-db\"],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${ROOT_FOLDER_HOST}/media/data/images/immich\",\n          \"containerPath\": \"/usr/src/app/upload\"\n        },\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/immich-ml-cache\",\n          \"containerPath\": \"/cache\"\n        }\n      ]\n    },\n    {\n      \"name\": \"immich-redis\",\n      \"image\": \"redis:6.2\",\n      \"healthCheck\": {\n        \"test\": \"redis-cli ping || exit 1\"\n      }\n    },\n    {\n      \"name\": \"immich-db\",\n      \"image\": \"ghcr.io/immich-app/postgres:14-vectorchord0.3.0-pgvectors0.2.0\",\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"tipi\"\n        },\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"immich\"\n        },\n        {\n          \"key\": \"PG_DATA\",\n          \"value\": \"/var/lib/postgresql/data\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/db\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ]\n    }\n  ],\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\"\n}\n",
  "config": {
    "path": "apps/immich/config.json",
    "content": "{\n  \"$schema\": \"../app-info-schema.json\",\n  \"name\": \"Immich\",\n  \"available\": true,\n  \"exposable\": true,\n  \"dynamic_config\": true,\n  \"port\": 8128,\n  \"id\": \"immich\",\n  \"tipi_version\": 218,\n  \"version\": \"v3.1.0\",\n  \"categories\": [\"data\", \"photography\"],\n  \"description\": \"Photo and video backup solution directly from your mobile phone.\",\n  \"short_desc\": \"Photo and video backup solution directly from your mobile phone.\",\n  \"author\": \"Alex Tran\",\n  \"website\": \"https://www.immich.app/\",\n  \"source\": \"https://github.com/immich-app/immich\",\n  \"form_fields\": [\n    {\n      \"type\": \"random\",\n      \"label\": \"DB_PASSWORD\",\n      \"min\": 32,\n      \"env_variable\": \"DB_PASSWORD\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"JWT_SECRET\",\n      \"min\": 32,\n      \"env_variable\": \"JWT_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"IMMICH_TYPESENSE_API_KEY\",\n      \"min\": 32,\n      \"env_variable\": \"IMMICH_TYPESENSE_API_KEY\"\n    }\n  ],\n  \"supported_architectures\": [\"arm64\", \"amd64\"],\n  \"created_at\": 1691943801422,\n  \"updated_at\": 1785369573748,\n  \"min_tipi_version\": \"4.5.0\"\n}\n"
  },
  "image_pins": [
